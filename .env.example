# ===== Copy this file to .env and fill in real values =====

# Django secret key — generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-in-production-please-0987654321

# Set False in production
DEBUG=True

# Allowed hosts (comma-separated). Render adds its host automatically.
# Example: ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CSRF trusted origins (comma-separated)
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# ---- Database ----
# Leave empty for local SQLite. For Neon PostgreSQL use the full connection string:
# postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# ---- AI API ----
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# Chatbot behavior
CHATBOT_MAX_HISTORY=10

# ---- Email (optional) ----
DEFAULT_FROM_EMAIL=noreply@studentportal.example
